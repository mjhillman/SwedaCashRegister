@inject IJSRuntime JS
@using MudBlazor

<MudDialog>
    <DialogContent>
        <div id="receipt-content"
             style="max-height:60vh; overflow-y:auto; background:#fff; padding:12px; border:1px solid #ccc;">

            <pre style="font-family:'Courier New', monospace;
                        font-size:12px;
                        white-space:pre-wrap;
                        margin:0;">@ReceiptText</pre>

        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Print"
                   Color="Color.Primary"
                   Variant="Variant.Filled">
            Print
        </MudButton>

        <MudButton OnClick="@Close"
                   Color="Color.Default"
                   Variant="Variant.Text">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string ReceiptText { get; set; } = string.Empty;

    private async Task Print()
    {
        await JS.InvokeVoidAsync("printReceipt", "receipt-content");
    }

    private void Close()
    {
        MudDialog.Cancel();
    }
}@* @inject IJSRuntime JS
