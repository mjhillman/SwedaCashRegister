@using HITS.Blazor.PushButton

<div class="keyboard-cluster" style="--btn-size:@(ButtonHeight)px; --row-gap:@(RowGap)rem;">

    <div class="tax-column">
        <PushButton ButtonWidth="@DeptButtonWidth" ButtonHeight="@DeptButtonHeight" Color="black" Class="dept-button-text" ShowHighlight="false" Text="TAXABLE" />
        <div class="tax-spacer"></div>
        <PushButton ButtonWidth="@DeptButtonWidth" ButtonHeight="@DeptButtonHeight" Color="black" Class="dept-button-text" ShowHighlight="false" Text="NON-TAX" />
    </div>

    <div class="button-keyboard">
        <div class="button-row">
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="900" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="90" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="9" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="90" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="9" />
        </div>
        <div class="button-row">
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="800" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="80" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="8" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="80" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="8" />
        </div>
        <div class="button-row">
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="700" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="70" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="7" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="70" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="7" />
        </div>
        <div class="button-row">
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="600" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="60" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="6" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="60" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="6" />
        </div>
        <div class="button-row">
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="500" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="50" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="5" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="50" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="5" />
        </div>
        <div class="button-row">
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="400" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="40" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="4" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="40" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="4" />
        </div>
        <div class="button-row">
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="300" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="30" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="3" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="30" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="3" />
        </div>
        <div class="button-row">
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="200" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="20" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="2" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="20" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="2" />
        </div>
        <div class="button-row">
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="100" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="10" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="white" Text="1" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="10" />
            <PushButton ButtonHeight="@ButtonHeight" ButtonWidth="@ButtonWidth" Color="green" Text="1" />
        </div>
    </div>
    <div class="tax-column">

        <PushButton ButtonHeight="@BigButtonHeight"
                    ButtonWidth="@BigButtonWidth"
                    Color="black"
                    Text="+"
                    ShowHighlight="false"
                    Class="enter-button" />

        <PushButton ButtonHeight="@BigButtonHeight"
                    ButtonWidth="@BigButtonWidth"
                    Color="black"
                    Text="SUB-TLT"
                    ShowHighlight="false"
                    Class="enter-button" />

        <PushButton ButtonHeight="@BigButtonHeight"
                    ButtonWidth="@BigButtonWidth"
                    Color="black"
                    Text="TOTAL"
                    ShowHighlight="false"
                    Class="enter-button" />
    </div>

</div>

@code {
    private const int ButtonHeight = 40;
    private const int ButtonWidth = 40;
    private const double RowGap = 0.5; // rem — MUST match .button-row's margin-bottom in CSS

    private const int BigButtonWidth = ButtonWidth * 2;
    private const int BigButtonHeight = ButtonHeight * 3;

    private const int DeptButtonWidth = ButtonWidth;
    private const int DeptButtonHeight = ButtonHeight * 5;

}