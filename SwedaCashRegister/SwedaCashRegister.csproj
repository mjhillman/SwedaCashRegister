<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Components\Custom\ReceiptGenerator.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Components\Custom\Keyboard.razor" />
    <Content Remove="Components\Custom\SwedaCase.razor" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Components\Custom\Keyboard.razor.css" />
    <None Remove="Components\Custom\SwedaCase.razor.css" />
    <None Remove="Footer.txt" />
    <None Remove="Header.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Footer.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Header.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.*" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\SharedProjects\HITS.Blazor.PushButton\HITS.Blazor.PushButton.csproj" />
  </ItemGroup>
</Project>